        <mxCell id="module3" value="3 Layout / dot / MMA legality&#xa;logical (M,K,N), ctor (M,N,K)&#xa;old vd=C, vs1=A, vs2=B^T, new vd=D&#xa;FP32/e32 · width 32 · full active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontColor=#1f2937;" vertex="1" parent="lowering"><mxGeometry x="570" y="145" width="240" height="110" as="geometry" /></mxCell>

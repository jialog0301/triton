        <mxCell id="non_generic" value="Constrained producer emission only: no generic conversion of arbitrary new LLVM IR and no textual replacement strategy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;dashed=1;fontStyle=1;fontSize=12;fontColor=#9b2c2c;" vertex="1" parent="lowering"><mxGeometry x="300" y="475" width="750" height="45" as="geometry" /></mxCell>

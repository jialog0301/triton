        <mxCell id="hardware" value="后续：Physical Ventus Hardware Driver&#xa;当前 checkout 未提供物理硬件 backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1f2937;dashed=1;" vertex="1" parent="1"><mxGeometry x="1340" y="950" width="300" height="65" as="geometry" /></mxCell>

        <mxCell id="profile" value="M3 verified generation record: pin/hash source + effective parameters + generated Verilog + testbench；inspected Verilog appears older/smaller&#xa;Logical mapping: M=DimM, K=DimN, N=DimK；logical order (M,K,N)，constructor positional order (M,N,K)；no unlabeled tuple&#xa;Operand binding: old vd=C accumulator；vs1=A[M,K]；vs2=physical B^T[N,K]；new vd=D；vftta.vv has 3 explicit operands (vm encoded control)&#xa;RTL + Spike mandatory；CycleSim 2x2x4-style capability-gated；16 meaningful D / 32 writeback lanes and fflags verify/freeze&#xa;M4 disabled until complete M3 manifest；M1/M2 basic backend path remains actionable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#374151;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1240" height="150" as="geometry" /></mxCell>
        <mxCell id="future_scope" value="Future / excluded：general/arbitrary tl.dot · generic/arbitrary MMA shapes · low precision MMA / FP16 / BF16 / FP8 · masked MMA · dynamic shared/local args · subgroup collectives · shuffle/ballot · atomics · async copy · cluster · warp specialization · physical driver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;dashed=1;fontColor=#9b2c2c;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1800" height="65" as="geometry" /></mxCell>

        <mxCell id="boundary" value="PROCESS BOUNDARY · pinned absolute Ventus LLVM 16 tools · no in-process linking / bitcode handoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=8 4;fontStyle=1;fontColor=#9b2c2c;fontSize=11;" vertex="1" parent="backend"><mxGeometry x="30" y="285" width="980" height="45" as="geometry" /></mxCell>
